{
  "manifest_version": 3,
  "name": "ColleurAnamnese",
  "version": "1.0",
  "description": "Remplit automatiquement les champs de l'anamnèse sur une fiche Salesforce",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["*://*.salesforce.com/*", "*://*.force.com/*"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Ouvrir ColleurAnamnese"
    }
  }
}
